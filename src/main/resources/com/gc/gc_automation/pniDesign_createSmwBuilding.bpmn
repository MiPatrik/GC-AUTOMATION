          <drools:metaValue><![CDATA[Initialize]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_CSB_SF_01</bpmn2:incoming>
      <bpmn2:outgoing>_CSB_SF_02</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("====================================================");
System.out.println("=== pniDesign_createSmwBuilding - Initialize ===");
System.out.println("====================================================");

System.out.println(String.format("globalReferenceId=%s crossProjectName=%s smwCountryCode=%s",
    globalReferenceId, crossProjectName, smwCountryCode));

if (smwCountryCode == null || smwCountryCode.isEmpty()) {
    throw new IllegalArgumentException("pniDesign_createSmwBuilding: smwCountryCode is required");
}
if (!"DE".equals(smwCountryCode) && !"DK".equals(smwCountryCode)) {
    throw new IllegalArgumentException("pniDesign_createSmwBuilding: unsupported smwCountryCode '" + smwCountryCode + "' - only DE/DK are configured");
}

kcontext.setVariable("smwSystemId", "PNI_" + smwCountryCode);
kcontext.setVariable("smwGetTokenSource", "smw/" + smwCountryCode + "/getToken");
kcontext.setVariable("smwCheckAddressSource", "smw/" + smwCountryCode + "/checkAddress");
kcontext.setVariable("smwCreateProjectSource", "smw/" + smwCountryCode + "/createProject");
kcontext.setVariable("smwCreateBuildingSource", "smw/" + smwCountryCode + "/createBuilding");
kcontext.setVariable("smwPostProjectChangesSource", "smw/" + smwCountryCode + "/postProjectChanges");
kcontext.setVariable("smwCheckProjectStateSource", "smw/" + smwCountryCode + "/checkProjectState");

kcontext.setVariable("errorMessage", null);
kcontext.setVariable("placeSmwId", null);
kcontext.setVariable("smwBuildingName", null);
]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_CSB_T_TOKEN" drools:taskName="SdcApiCall" name="REST_API_CALL:
smw/{country}/getToken">
      <bpmn2:documentation id="_CSB_DOC_T_TOKEN"><![CDATA[Obtain an OAuth2 client-credentials token from the SMW/PRM UAA for the resolved country (source name from smwGetTokenSource). (CREATE_OR_UPDATE)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
smw/{country}/getToken]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("===========================================================================");
System.out.println("=== pniDesign_createSmwBuilding - REST_API_CALL: smw/{country}/getToken ===");
System.out.println("===========================================================================");

smwAccessToken = null;
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: " + "accessToken=" + smwAccessToken);

if (smwAccessToken == null || smwAccessToken.isEmpty()) {
    kcontext.setVariable("errorMessage", "SMW token endpoint returned no access_token");
}
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
