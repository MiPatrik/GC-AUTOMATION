smwDesignIdRaw = null;
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[smwDesignId = (smwDesignIdRaw != null) ? String.valueOf(smwDesignIdRaw) : null;

System.out.println("Data Outputs: " + "designId=" + smwDesignId + ", " + "requestStatus=" + smwCreateProjectRequestStatus);

if (!"ok".equals(smwCreateProjectRequestStatus) || smwDesignId == null || smwDesignId.isEmpty()) {
    kcontext.setVariable("errorMessage", "SMW create project failed for '" + crossProjectName + "': request_status=" + smwCreateProjectRequestStatus);
}
]]></drools:script>
