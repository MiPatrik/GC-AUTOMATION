        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: " + "smwBuildingId=" + smwBuildingId + ", " + "smwBuildingName=" + smwBuildingName + ", " + "requestStatus=" + smwCreateBuildingRequestStatus);

if (!"ok".equals(smwCreateBuildingRequestStatus) || smwBuildingId == null || smwBuildingId.isEmpty()) {
    kcontext.setVariable("errorMessage", "SMW create building failed for address '" + globalReferenceId + "' in design '" + smwDesignId + "': request_status=" + smwCreateBuildingRequestStatus);
} else {
    kcontext.setVariable("placeSmwId", "building:" + smwBuildingId);
    if (smwBuildingName == null || smwBuildingName.isEmpty()) {
        kcontext.setVariable("smwBuildingName", "building:" + smwBuildingId);
    }
}
]]></drools:script>
