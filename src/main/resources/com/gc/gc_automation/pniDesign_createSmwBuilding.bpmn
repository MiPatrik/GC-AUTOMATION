    <bpmn2:task id="_CSB_T_CHECKADDR" drools:taskName="SdcApiCall" name="REST_API_CALL:
smw/{country}/checkAddress">
      <bpmn2:documentation id="_CSB_DOC_T_CHECKADDR"><![CDATA[Read-only check whether globalReferenceId already has a building in SMW/PRM (glb_nig_prm_api_get_record_details). Guards against CROSS/SMW being out of sync. (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
smw/{country}/checkAddress]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("===============================================================================");
System.out.println("=== pniDesign_createSmwBuilding - REST_API_CALL: smw/{country}/checkAddress ===");
System.out.println("===============================================================================");

smwExistingBuildingId = null;
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: " + "requestStatus=" + smwCheckAddressRequestStatus + ", " + "existingBuildingId=" + smwExistingBuildingId);

if (!"ok".equals(smwCheckAddressRequestStatus)) {
    kcontext.setVariable("errorMessage", "SMW check address failed for '" + globalReferenceId + "': request_status=" + smwCheckAddressRequestStatus);
} else if (smwExistingBuildingId != null && !smwExistingBuildingId.isEmpty()) {
    kcontext.setVariable("errorMessage", "SMW already has a building (" + smwExistingBuildingId + ") for address '" + globalReferenceId + "' - CROSS/SMW out of sync");
}
]]></drools:script>
        </drools:onExit-script>
