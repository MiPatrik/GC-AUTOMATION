  <bpmn2:process id="GC-AUTOMATION.pniDesign_createSmwBuilding" drools:packageName="com.gc.gc_automation" drools:version="1.0" drools:adHoc="false" name="pniDesign_createSmwBuilding" isExecutable="true" processType="Public">
    <bpmn2:documentation id="_CSB_DOC_0001"><![CDATA[Sub-process of pniDesign_createPlace (globalconnect#42 rework). Performs the full, real PRM API integration flow: get token, check address, create project, create empty building with AP, post project changes, check project state - all against the smw/{country}/* runtime-config sources selected by smwCountryCode. Inputs: globalReferenceId, crossProjectName, smwCountryCode. Outputs: placeSmwId, smwBuildingName, smwSystemId, errorMessage (null on success).]]></bpmn2:documentation>
    <bpmn2:extensionElements>
