    <bpmn2:task id="_66802770-F17A-4E61-BD29-2BC24B1D632B" drools:taskName="SdcApiCall" name="REST_API_CALL:
cross/executeQuery/findParentNodeByType
(edge equipment SHELF parent)">
      <bpmn2:documentation id="_KYZg6bKgEfGAdplLL88P2Q"><![CDATA[Find the network-side cage's (networkSideCageCrossId) ancestor node of type SHELF (the network edge equipment, MER/MAS) and read its status, so the commit is rejected if that edge equipment is not ACTIVE. GENERIC source (parent-of-type-X, mirror of cross/executeQuery/findChildNodeByType). (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/executeQuery/findParentNodeByType
(edge equipment SHELF parent)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("===========================================================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/executeQuery/findParentNodeByType (edge equipment SHELF parent)");
System.out.println("===========================================================================================================");

kcontext.setVariable("edgeEquipmentShelfCrossId", null);
kcontext.setVariable("edgeEquipmentShelfStatusDiscriminator", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: edgeEquipmentShelfCrossId=" + edgeEquipmentShelfCrossId + ", edgeEquipmentShelfStatusDiscriminator=" + edgeEquipmentShelfStatusDiscriminator);
if (edgeEquipmentShelfCrossId == null || edgeEquipmentShelfCrossId.isEmpty()) {
    kcontext.setVariable("errorMessage", "Network-side cage '" + networkSideCageCrossId + "' has no ancestor node of type SHELF");
} else if (edgeEquipmentShelfStatusDiscriminator != null && !"ACTIVE".equalsIgnoreCase(edgeEquipmentShelfStatusDiscriminator)) {
    kcontext.setVariable("errorMessage", "Edge equipment SHELF node '" + edgeEquipmentShelfCrossId + "' is not ACTIVE (was '" + edgeEquipmentShelfStatusDiscriminator + "')");
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
