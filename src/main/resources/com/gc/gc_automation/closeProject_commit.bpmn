    <bpmn2:task id="_F2E22632-D45F-5E2E-8334-EA77233FCD6F" drools:taskName="SdcApiCall" name="REST_API_CALL:
cross/findLinkByEndNode
(customer patch cord)">
      <bpmn2:documentation id="_8qzA-XoxEfG20Kz8fLTUEg"><![CDATA[Find the OPTICAL_PATCH_CORD terminating on the customer-side cage (either end, orientation does not matter). (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findLinkByEndNode
(customer patch cord)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("============================================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/executeQuery/findLinkByEndNode (customer patch cord)");
System.out.println("============================================================================================");

kcontext.setVariable("customerSidePatchCordCrossId", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: customerSidePatchCordCrossId=" + customerSidePatchCordCrossId);
if (customerSidePatchCordCrossId == null) {
    kcontext.setVariable("errorMessage", "Unable to resolve the OPTICAL_PATCH_CORD terminating on the customer-side cage '" + customerSideCageCrossId + "'");
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
