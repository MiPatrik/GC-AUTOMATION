    <bpmn2:task id="_1CFA91F2-0488-5F72-8C4A-BA4FDBD628A1" drools:taskName="SdcApiCall" name="TMF_STORE:&#10;get data">
      <bpmn2:documentation id="_CP000021"><![CDATA[Retrieves data from automaton's tmf_store table using TMF_STORE domain and JSONATA transformation.]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[TMF_STORE:
get data]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("==================================================");
System.out.println("closeProject_commit - Get data from TMF_STORE");
System.out.println("==================================================");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: version=" + version + ", crossProjectName=" + crossProjectName + ", serviceCrossId=" + serviceCrossId + ", operation=" + operation + ", vlan=" + vlan + ", customerPatchCordType=" + customerPatchCordType + ", customerSfpType=" + customerSfpType + ", networkPatchCordType=" + networkPatchCordType + ", networkSfpType=" + networkSfpType);
// validate the requested operation //TODO "operation" is NOT in the ODIN contract 0.97 - CONTRACT MISMATCH
if (operation != null && !"COMMIT".equalsIgnoreCase(operation)) {
    kcontext.setVariable("errorMessage", "Unsupported operation '" + operation + "' - only 'COMMIT' is supported");
}]]></drools:script>
        </drools:onExit-script>
