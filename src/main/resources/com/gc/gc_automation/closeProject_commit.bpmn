    <bpmn2:task id="_A9CE3FDE-4291-5667-9A10-2A924172F2C8" drools:taskName="SdcApiCall" name="REST_API_CALL:
cross/findProject">
      <bpmn2:documentation id="_KYaIS7KgEfGAdplLL88P2Q"><![CDATA[Retrieve project crossProjectName via CROSS API. (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findProject]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("===================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/findProject");
System.out.println("===================================================");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: projectCrossId=" + projectCrossId);
// an empty search result is HTTP 200 with items=[], so the handler does not throw - fail fast here
// instead of carrying a null projectCrossId all the way to cross/commitProject.
if (projectCrossId == null || projectCrossId.isEmpty()) {
    kcontext.setVariable("errorMessage", "CROSS project '" + crossProjectName + "' not found");
}]]></drools:script>
        </drools:onExit-script>
