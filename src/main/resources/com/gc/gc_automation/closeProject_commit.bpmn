cross/findLinkEnds (ETH link)">
      <bpmn2:documentation id="_8qzn5noxEfG20Kz8fLTUEg"><![CDATA[Read the start/end cages of the ETH_L2 link: startNode = network-side cage (MER/MAS:CAGE), endNode = customer-side cage (CPE:CAGE). (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findLinkEnds (ETH link)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("===============================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/findLinkEnds (ETH link)");
System.out.println("===============================================================");

kcontext.setVariable("networkSideCageCrossId", null);
kcontext.setVariable("customerSideCageCrossId", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: networkSideCageCrossId=" + networkSideCageCrossId + ", customerSideCageCrossId=" + customerSideCageCrossId);
if (networkSideCageCrossId == null || customerSideCageCrossId == null) {
    kcontext.setVariable("errorMessage", "Unable to resolve the cages (startNode/endNode) of the ETH link '" + ethLinkCrossId + "'");
}]]></drools:script>
        </drools:onExit-script>
