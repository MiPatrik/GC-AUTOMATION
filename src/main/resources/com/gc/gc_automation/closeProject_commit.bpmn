    <bpmn2:task id="_21A1D8BA-4C95-5E40-AB14-B690A207A1F2" drools:taskName="SdcApiCall" name="REST_API_CALL:&#10;cross/findLinkEnds&#10;(optical circuit)">
      <bpmn2:documentation id="_CP0000FD"><![CDATA[Read the start/end OPTICAL_CONNECTOR (ODF) nodes of the OPTICAL_CIRCUIT (after SMW sync). (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findLinkEnds
(optical circuit)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("======================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/findLinkEnds (optical circuit)");
System.out.println("======================================================================");

kcontext.setVariable("opticalCircuitStartNodeCrossId", null);
kcontext.setVariable("opticalCircuitEndNodeCrossId", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: opticalCircuitStartNodeCrossId=" + opticalCircuitStartNodeCrossId + ", opticalCircuitEndNodeCrossId=" + opticalCircuitEndNodeCrossId);
if (opticalCircuitStartNodeCrossId == null || opticalCircuitEndNodeCrossId == null) {
    kcontext.setVariable("errorMessage", "Unable to resolve the ODF OPTICAL_CONNECTOR ends of the optical circuit '" + opticalCircuitCrossId + "'");
}]]></drools:script>
        </drools:onExit-script>
