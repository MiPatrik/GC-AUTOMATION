        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("==========================================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/executeQuery/findChildNodeByType (customer SFP LP)");
System.out.println("==========================================================================================");

kcontext.setVariable("cpeSfpLogicalPortCrossId", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: cpeSfpLogicalPortCrossId=" + cpeSfpLogicalPortCrossId);
if (cpeSfpLogicalPortCrossId == null) {
