    <bpmn2:task id="_2E4F8BD6-67E8-4AB0-97E6-284C3DCBBF14" drools:taskName="SdcApiCall" name="REST_API_CALL:
cross/findMaterialTemplate
(network patch cord)">
      <bpmn2:documentation id="_KYZhWrKgEfGAdplLL88P2Q"><![CDATA[Verify networkPatchCordType exists as a CROSS material template. Fourth and last check; last task of the pre-validation group. (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findMaterialTemplate
(network patch cord)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("=================================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/findMaterialTemplate (network patch cord)");
System.out.println("=================================================================================");

kcontext.setVariable("materialTemplateCrossId", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: materialTemplateCrossId=" + materialTemplateCrossId);
if (materialTemplateCrossId == null || materialTemplateCrossId.isEmpty()) {
    kcontext.setVariable("errorMessage", "Material template '" + networkPatchCordType + "' (networkPatchCordType) not found");
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
