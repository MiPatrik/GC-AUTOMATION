    <bpmn2:scriptTask id="_3C4C8B46-38B7-5ADF-9B06-2541C7F8AA39" name="find
cpeCrossId" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[find
cpeCrossId]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_D68A8811-5D85-50D4-BCD7-C71A43BA1F7B</bpmn2:incoming>
      <bpmn2:outgoing>_F8587C77-E4E8-5A19-B08F-92AB85974B8A</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("==================================================");
System.out.println("closeProject_commit - find cpeCrossId");
System.out.println("==================================================");

java.util.List<?> components = (java.util.List<?>) kcontext.getVariable("servicePhysicalAccessComponents");
boolean found = false;
if (components != null) {
    for (Object item : components) {
        java.util.Map<String, Object> sc = (java.util.Map<String, Object>) item;
        if ("CPE".equals(sc.get("componentTypeName"))) {
            java.util.List<?> resources = (java.util.List<?>) sc.get("resources");
            if (resources == null || resources.isEmpty()) {
                kcontext.setVariable("errorMessage", "Service component CPE has no resources");
                return;
            }
            java.util.Map<String, Object> resource = (java.util.Map<String, Object>) resources.get(0);
            if (resources.size() > 1) {
                for (Object ro : resources) {
                    java.util.Map<String, Object> r = (java.util.Map<String, Object>) ro;
                    Object primary = r.get("primary");
                    if (primary != null && ((Boolean) primary).booleanValue()) {
                        resource = r;
                    }
                }
            }
            java.util.Map<String, Object> resourceRef = (java.util.Map<String, Object>) resource.get("resourceRef");
            kcontext.setVariable("cpeCrossId", (String) resourceRef.get("id"));
            found = true;
        }
    }
}
if (!found) {
    kcontext.setVariable("errorMessage", "Unable to find service component CPE at the given service");
}
System.out.println("cpeCrossId=" + kcontext.getVariable("cpeCrossId"));]]></bpmn2:script>
    </bpmn2:scriptTask>
