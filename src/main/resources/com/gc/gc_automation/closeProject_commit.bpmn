    <bpmn2:task id="_C4761E51-22D7-5E50-9AE7-CA0354C100D7" drools:taskName="SdcApiCall" name="REST_API_CALL:
cross/findLinkByEndNode
(network patch cord)">
      <bpmn2:documentation id="_KYaH8LKgEfGAdplLL88P2Q"><![CDATA[Find the OPTICAL_PATCH_CORD terminating on the network-side cage (either end, orientation does not matter). (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findLinkByEndNode
(network patch cord)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("===========================================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/executeQuery/findLinkByEndNode (network patch cord)");
System.out.println("===========================================================================================");

kcontext.setVariable("networkSidePatchCordCrossId", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: networkSidePatchCordCrossId=" + networkSidePatchCordCrossId);
if (networkSidePatchCordCrossId == null) {
    kcontext.setVariable("errorMessage", "Unable to resolve the OPTICAL_PATCH_CORD terminating on the network-side cage '" + networkSideCageCrossId + "'");
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
