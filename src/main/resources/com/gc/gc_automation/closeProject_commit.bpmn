    <bpmn2:scriptTask id="_1AC9B617-F01F-569A-A691-336A4F4C3676" name="find
ethLinkCrossId" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[find
ethLinkCrossId]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_D171A4A2-23FF-5CA6-9C6B-E39D3D221628</bpmn2:incoming>
      <bpmn2:outgoing>_F8BD2D2A-2A75-5854-B7DB-1AC01037006B</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("==================================================");
System.out.println("closeProject_commit - find ethLinkCrossId");
System.out.println("==================================================");

java.util.List<?> components = (java.util.List<?>) kcontext.getVariable("serviceAccessComponents");
boolean found = false;
if (components != null) {
    for (Object item : components) {
        java.util.Map<String, Object> sc = (java.util.Map<String, Object>) item;
        if ("LOGICAL_CONNECTIVITY".equals(sc.get("componentTypeName"))) {
            java.util.List<?> resources = (java.util.List<?>) sc.get("resources");
            if (resources == null || resources.isEmpty()) {
                kcontext.setVariable("errorMessage", "Service component LOGICAL_CONNECTIVITY has no resources");
                return;
            }
            java.util.Map<String, Object> resource = (java.util.Map<String, Object>) resources.get(0);
            if (resources.size() > 1) {
                for (Object ro : resources) {
                    java.util.Map<String, Object> r = (java.util.Map<String, Object>) ro;
                    Object primary = r.get("primary");
                    if (primary != null && ((Boolean) primary).booleanValue()) {
                        resource = r;
                    }
                }
            }
            java.util.Map<String, Object> resourceRef = (java.util.Map<String, Object>) resource.get("resourceRef");
            kcontext.setVariable("ethLinkCrossId", (String) resourceRef.get("id"));
            found = true;
        }
    }
}
if (!found) {
    kcontext.setVariable("errorMessage", "Unable to find service component LOGICAL_CONNECTIVITY at the given service");
}
System.out.println("ethLinkCrossId=" + kcontext.getVariable("ethLinkCrossId"));]]></bpmn2:script>
    </bpmn2:scriptTask>
