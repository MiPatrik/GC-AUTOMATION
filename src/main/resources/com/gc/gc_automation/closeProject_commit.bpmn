    <bpmn2:task id="_42D7E4A4-058F-4A3C-AD00-500FC792655A" drools:taskName="SdcApiCall" name="REST_API_CALL:
cross/executeQuery/findChildNodeByTypeWithStatus
(edge equipment NE child of SHELF)">
      <bpmn2:documentation id="_42D7E4A4-058F-4A3C-AD00-500FC792655A_doc"><![CDATA[Find the SHELF's (edgeEquipmentShelfCrossId, found by the task above) child node of type NETWORK_ELEMENT and read its status, so the commit is rejected if that NE is not ACTIVE. NEW dedicated source (child-of-type-X WITH status) - NOT the plain findChildNodeByType, which has no status column and is shared by the SFP LOGICAL_PORT lookups later in this flow (globalconnect#68). (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/executeQuery/findChildNodeByTypeWithStatus
(edge equipment NE child of SHELF)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("===========================================================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/executeQuery/findChildNodeByTypeWithStatus (edge equipment NE child of SHELF)");
System.out.println("===========================================================================================================");

kcontext.setVariable("edgeEquipmentNeCrossId", null);
kcontext.setVariable("edgeEquipmentNeStatusDiscriminator", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: edgeEquipmentNeCrossId=" + edgeEquipmentNeCrossId + ", edgeEquipmentNeStatusDiscriminator=" + edgeEquipmentNeStatusDiscriminator);
if (edgeEquipmentNeCrossId == null || edgeEquipmentNeCrossId.isEmpty()) {
    kcontext.setVariable("errorMessage", "Edge equipment SHELF '" + edgeEquipmentShelfCrossId + "' has no child node of type NETWORK_ELEMENT");
} else if (edgeEquipmentNeStatusDiscriminator != null && !"ACTIVE".equalsIgnoreCase(edgeEquipmentNeStatusDiscriminator)) {
    kcontext.setVariable("errorMessage", "Edge equipment NETWORK_ELEMENT node '" + edgeEquipmentNeCrossId + "' is not ACTIVE (was '" + edgeEquipmentNeStatusDiscriminator + "')");
}]]></drools:script>
        </drools:onExit-script>
