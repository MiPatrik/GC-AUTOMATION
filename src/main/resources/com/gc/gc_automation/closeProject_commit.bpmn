      <bpmn2:documentation id="_KYZhR7KgEfGAdplLL88P2Q"><![CDATA[Verify customerSfpType exists as a CROSS material template (read-only search). First of four material-template existence checks. (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findMaterialTemplate
(customer SFP)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("==========================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/findMaterialTemplate (customer SFP)");
System.out.println("==========================================================================");

kcontext.setVariable("materialTemplateCrossId", null);]]></drools:script>
