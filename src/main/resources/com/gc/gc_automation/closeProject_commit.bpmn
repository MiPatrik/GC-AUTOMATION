    <bpmn2:task id="_0E015820-E443-4C22-AC5C-93DB52223CFE" drools:taskName="SdcApiCall" name="REST_API_CALL:
cross/findMaterialTemplate
(customer patch cord)">
      <bpmn2:documentation id="_KYYTHrKgEfGAdplLL88P2Q"><![CDATA[Verify customerPatchCordType exists as a CROSS material template. Third check - this is the exact template name that, unvalidated, previously failed deep inside deployLinkMaterialTemplate after the customer SFP had already been created. (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findMaterialTemplate
(customer patch cord)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("==================================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/findMaterialTemplate (customer patch cord)");
System.out.println("==================================================================================");

kcontext.setVariable("materialTemplateCrossId", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: materialTemplateCrossId=" + materialTemplateCrossId);
if (materialTemplateCrossId == null || materialTemplateCrossId.isEmpty()) {
    kcontext.setVariable("errorMessage", "Material template '" + customerPatchCordType + "' (customerPatchCordType) not found");
}]]></drools:script>
        </drools:onExit-script>
