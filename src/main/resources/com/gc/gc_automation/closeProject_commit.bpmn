    <bpmn2:task id="_158A9FEB-2539-5A96-9193-0A75434BB4EB" drools:taskName="SdcApiCall" name="REST_API_CALL:&#10;cross/updateEthLink">
      <bpmn2:documentation id="_CP0001DF"><![CDATA[Re-terminate the ETH link on the SFP LOGICAL_PORTs (startNode = MER/MAS:SFP:LP, endNode = CPE:SFP:LP) and REPLACE its providers (network patch cord + optical circuit + customer patch cord) in a single PUT; the source hardcodes _meta_providersImplicitRemove=true so the task is idempotent. (CREATE_OR_UPDATE)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/updateEthLink]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("=====================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/updateEthLink");
System.out.println("=====================================================");

java.util.List<Object> providers = new java.util.ArrayList<Object>();

java.util.Map<String, Object> networkSidePatchCord = new java.util.HashMap<String, Object>();
networkSidePatchCord.put("providerCrossId", kcontext.getVariable("networkSidePatchCordCrossId"));
networkSidePatchCord.put("consumptionType", "MAIN");
networkSidePatchCord.put("reversed", false);
networkSidePatchCord.put("orderNumber", 1);
networkSidePatchCord.put("fibrilNumber", 1);
providers.add(networkSidePatchCord);

java.util.Map<String, Object> opticalCircuit = new java.util.HashMap<String, Object>();
opticalCircuit.put("providerCrossId", kcontext.getVariable("opticalCircuitCrossId"));
opticalCircuit.put("consumptionType", "MAIN");
opticalCircuit.put("reversed", false);
opticalCircuit.put("orderNumber", 1);
opticalCircuit.put("fibrilNumber", 1);
providers.add(opticalCircuit);

java.util.Map<String, Object> customerSidePatchCord = new java.util.HashMap<String, Object>();
customerSidePatchCord.put("providerCrossId", kcontext.getVariable("customerSidePatchCordCrossId"));
customerSidePatchCord.put("consumptionType", "MAIN");
customerSidePatchCord.put("reversed", false);
customerSidePatchCord.put("orderNumber", 1);
customerSidePatchCord.put("fibrilNumber", 1);
providers.add(customerSidePatchCord);

kcontext.setVariable("ethLinkProviders", providers);]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
