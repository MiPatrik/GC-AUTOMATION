    <bpmn2:task id="_44B27552-82E6-5633-83FB-77A522D3103B" drools:taskName="SdcApiCall" name="REST_API_CALL:&#10;cross/findService">
      <bpmn2:documentation id="_CP000079"><![CDATA[Retrieve service serviceCrossId via CROSS API; check it is still DESIGNED (pre-commit). (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findService]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("===================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/findService");
System.out.println("===================================================");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: serviceStatus=" + serviceStatus + ", serviceComponents=" + serviceComponents);
// the project may only be committed for a service that is still DESIGNED (the pre-commit state).
// GC defines ONLY ACTIVE / DELETED / DESIGNED service statuses - there is no "PLANNED" status.
if (serviceStatus != null && !"DESIGNED".equalsIgnoreCase(serviceStatus)) {
    kcontext.setVariable("errorMessage", "Service '" + serviceCrossId + "' is not in the expected 'DESIGNED' status (was '" + serviceStatus + "')");
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
