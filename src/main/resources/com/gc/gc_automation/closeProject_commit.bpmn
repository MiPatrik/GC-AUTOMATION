    <bpmn2:task id="_FDF4AEA7-9B78-5C89-B544-D6159EB6B14A" drools:taskName="SdcApiCall" name="REST_API_CALL:&#10;cross/findChildNodeByType&#10;(network SFP LP)">
      <bpmn2:documentation id="_CP000198"><![CDATA[Resolve the LOGICAL_PORT of the network-side SFP (the newest direct or indirect LOGICAL_PORT child of the SFP node). (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findChildNodeByType
(network SFP LP)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("=========================================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/executeQuery/findChildNodeByType (network SFP LP)");
System.out.println("=========================================================================================");

kcontext.setVariable("networkSfpLogicalPortCrossId", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: networkSfpLogicalPortCrossId=" + networkSfpLogicalPortCrossId);
if (networkSfpLogicalPortCrossId == null) {
    kcontext.setVariable("errorMessage", "Unable to resolve the LOGICAL_PORT of the network-side SFP '" + networkSfpCrossId + "'");
}]]></drools:script>
        </drools:onExit-script>
