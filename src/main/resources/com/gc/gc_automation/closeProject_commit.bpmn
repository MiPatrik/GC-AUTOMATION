    <bpmn2:task id="_D0EE1A2C-F3AD-5DBA-9673-FD10D43AC48F" drools:taskName="SdcApiCall" name="REST_API_CALL:&#10;cross/findChildNodeByType&#10;(customer SFP LP)">
      <bpmn2:documentation id="_CP000132"><![CDATA[Resolve the LOGICAL_PORT of the customer-side SFP (the newest direct or indirect LOGICAL_PORT child of the SFP node). (FIND)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
cross/findChildNodeByType
(customer SFP LP)]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("==========================================================================================");
System.out.println("closeProject_commit - REST_API_CALL: cross/executeQuery/findChildNodeByType (customer SFP LP)");
System.out.println("==========================================================================================");

kcontext.setVariable("cpeSfpLogicalPortCrossId", null);]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: cpeSfpLogicalPortCrossId=" + cpeSfpLogicalPortCrossId);
if (cpeSfpLogicalPortCrossId == null) {
    kcontext.setVariable("errorMessage", "Unable to resolve the LOGICAL_PORT of the customer-side SFP '" + cpeSfpCrossId + "'");
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
