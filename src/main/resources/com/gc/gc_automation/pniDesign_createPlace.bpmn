System.out.println("================================================================");

placeCrossId = null;
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: placeCrossId=" + placeCrossId + ", httpStatusCode=" + httpStatusCode + ", message=" + message);

