    <bpmn2:sequenceFlow id="_CPL_SF_11" name="CROSS failed" sourceRef="_CPL_GW_CROSS" targetRef="_CPL_THROW_FAILED_CROSS">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[CROSS failed]]></drools:metaValue>
