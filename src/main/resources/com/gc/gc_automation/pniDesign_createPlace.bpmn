      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_CPL_COND_0002" language="http://www.java.com/java"><![CDATA[return errorMessage != null;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_CPL_SF_06" sourceRef="_CPL_T_SMW" targetRef="_CPL_GW_SMW"/>
    <bpmn2:sequenceFlow id="_CPL_SF_07" sourceRef="_CPL_GW_SMW" targetRef="_CPL_T_CROSS"/>
    <bpmn2:sequenceFlow id="_CPL_SF_08" name="SMW failed" sourceRef="_CPL_GW_SMW" targetRef="_CPL_THROW_FAILED_SMW">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[SMW failed]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_CPL_COND_0003" language="http://www.java.com/java"><![CDATA[return errorMessage != null;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_CPL_SF_09" sourceRef="_CPL_T_CROSS" targetRef="_CPL_GW_CROSS"/>
    <bpmn2:sequenceFlow id="_CPL_SF_10" sourceRef="_CPL_GW_CROSS" targetRef="_CPL_THROW_COMPLETED"/>
    <bpmn2:sequenceFlow id="_CPL_SF_11" name="CROSS failed" sourceRef="_CPL_GW_CROSS" targetRef="_CPL_THROW_FAILED_CROSS">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[CROSS failed]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_CPL_COND_0004" language="http://www.java.com/java"><![CDATA[return errorMessage != null;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_CPL_SF_12" sourceRef="_CPL_CATCH_COMPLETED" targetRef="_CPL_RESULT_COMPLETED"/>
    <bpmn2:sequenceFlow id="_CPL_SF_13" sourceRef="_CPL_RESULT_COMPLETED" targetRef="_CPL_END_COMPLETED"/>
    <bpmn2:sequenceFlow id="_CPL_SF_14" sourceRef="_CPL_CATCH_FAILED" targetRef="_CPL_RESULT_FAILED"/>
    <bpmn2:sequenceFlow id="_CPL_SF_15" sourceRef="_CPL_RESULT_FAILED" targetRef="_CPL_END_FAILED"/>
    <bpmn2:startEvent id="_CPL_START">
      <bpmn2:outgoing>_CPL_SF_01</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:endEvent id="_CPL_END_COMPLETED">
      <bpmn2:incoming>_CPL_SF_13</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="_CPL_END_FAILED">
      <bpmn2:incoming>_CPL_SF_15</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:intermediateThrowEvent id="_CPL_THROW_COMPLETED" name="Completed">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Completed]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_CPL_SF_10</bpmn2:incoming>
      <bpmn2:linkEventDefinition id="_CPL_LINK_COMPLETED_THROW" name="Completed">
        <bpmn2:target>_CPL_LINK_COMPLETED_CATCH</bpmn2:target>
      </bpmn2:linkEventDefinition>
    </bpmn2:intermediateThrowEvent>
    <bpmn2:intermediateThrowEvent id="_CPL_THROW_FAILED_TOKEN" name="Failed">
      <bpmn2:extensionElements>
