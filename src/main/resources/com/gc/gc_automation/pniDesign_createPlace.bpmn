      <bpmn2:linkEventDefinition id="_CPL_LINK_FAILED_CATCH" name="Failed">
        <bpmn2:source>_CPL_LINK_FAILED_THROW_TOKEN</bpmn2:source>
        <bpmn2:source>_CPL_LINK_FAILED_THROW_SMW</bpmn2:source>
        <bpmn2:source>_CPL_LINK_FAILED_THROW_CROSS</bpmn2:source>
      </bpmn2:linkEventDefinition>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:scriptTask id="_CPL_INIT" name="Initialize" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Initialize]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_CPL_SF_01</bpmn2:incoming>
      <bpmn2:outgoing>_CPL_SF_02</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("==========================================");
System.out.println("=== pniDesign_createPlace - Initialize ===");
System.out.println("==========================================");

System.out.println(String.format("addressCrossId=%s globalReferenceId=%s crossProjectName=%s addressLatitude=%s addressLongitude=%s",
    addressCrossId, globalReferenceId, crossProjectName, addressLatitude, addressLongitude));

if (addressCrossId == null || addressCrossId.isEmpty()) {
    throw new IllegalArgumentException("pniDesign_createPlace: addressCrossId is required");
}
if (globalReferenceId == null || globalReferenceId.isEmpty()) {
    throw new IllegalArgumentException("pniDesign_createPlace: globalReferenceId (SMW address_id) is required");
}
if (crossProjectName == null || crossProjectName.isEmpty()) {
    throw new IllegalArgumentException("pniDesign_createPlace: crossProjectName is required");
}
if (addressLatitude == null || addressLongitude == null) {
    throw new IllegalArgumentException("pniDesign_createPlace: address coordinates are required to place the CROSS node");
}

// Smallworld instance the building is created in; DE only (same rule as updateCustomerRoom).
kcontext.setVariable("smwSystemId", "PNI_DE");

// TODO SMW project names are generated as <index>-<yy>-<orderNumber> by glb_nig_prm_api_create_project,
// which this flow does not call yet. Until then the SMW project is addressed by crossProjectName.
kcontext.setVariable("smwProjectName", crossProjectName);

kcontext.setVariable("errorMessage", null);
kcontext.setVariable("placeCrossId", null);
kcontext.setVariable("placeSmwId", null);
]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_CPL_T_TOKEN" drools:taskName="SdcApiCall" name="REST_API_CALL:
smw/getToken">
      <bpmn2:documentation id="_CPL_DOC_0005"><![CDATA[Obtains an OAuth2 client-credentials token from the SMW/PRM UAA (source smw/getToken).]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
smw/getToken]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("===========================================================");
System.out.println("=== pniDesign_createPlace - REST_API_CALL: smw/getToken ===");
System.out.println("===========================================================");

smwAccessToken = null;
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: smwAccessToken=" + (smwAccessToken == null ? "null" : "<redacted>"));

if (smwAccessToken == null || smwAccessToken.isEmpty()) {
    kcontext.setVariable("errorMessage", "SMW token endpoint returned no access_token");
}
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_CPL_SF_02</bpmn2:incoming>
      <bpmn2:outgoing>_CPL_SF_03</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_CPL_IOSPEC_0006">
        <bpmn2:dataInput id="_CPL_T_TOKEN_apiUrlInputX" drools:dtype="String" itemSubjectRef="__CPL_T_TOKEN_apiUrlInputXItem" name="apiUrl"/>
        <bpmn2:dataInput id="_CPL_T_TOKEN_routeMap.domainInputX" drools:dtype="String" itemSubjectRef="__CPL_T_TOKEN_routeMap.domainInputXItem" name="routeMap.domain"/>
        <bpmn2:dataInput id="_CPL_T_TOKEN_routeMap.sourceInputX" drools:dtype="String" itemSubjectRef="__CPL_T_TOKEN_routeMap.sourceInputXItem" name="routeMap.source"/>
        <bpmn2:dataInput id="_CPL_T_TOKEN_TaskNameInputX" drools:dtype="Object" name="TaskName"/>
        <bpmn2:dataOutput id="_CPL_T_TOKEN_accessTokenOutputX" drools:dtype="String" itemSubjectRef="__CPL_T_TOKEN_accessTokenOutputXItem" name="accessToken"/>
        <bpmn2:inputSet id="_CPL_INSET_0007">
          <bpmn2:dataInputRefs>_CPL_T_TOKEN_apiUrlInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_CPL_T_TOKEN_routeMap.domainInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_CPL_T_TOKEN_routeMap.sourceInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_CPL_T_TOKEN_TaskNameInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="_CPL_OUTSET_0008">
          <bpmn2:dataOutputRefs>_CPL_T_TOKEN_accessTokenOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="_CPL_DIA_0009">
        <bpmn2:sourceRef>_apiCallUrl</bpmn2:sourceRef>
        <bpmn2:targetRef>_CPL_T_TOKEN_apiUrlInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_CPL_DIA_0010">
        <bpmn2:targetRef>_CPL_T_TOKEN_routeMap.domainInputX</bpmn2:targetRef>
        <bpmn2:assignment id="_CPL_ASG_0011">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression" id="_CPL_FROM_0012"><![CDATA[REST_API_CALL]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression" id="_CPL_TO_0013">_CPL_T_TOKEN_routeMap.domainInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_CPL_DIA_0014">
        <bpmn2:targetRef>_CPL_T_TOKEN_routeMap.sourceInputX</bpmn2:targetRef>
        <bpmn2:assignment id="_CPL_ASG_0015">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression" id="_CPL_FROM_0016"><![CDATA[smw/getToken]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression" id="_CPL_TO_0017">_CPL_T_TOKEN_routeMap.sourceInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_CPL_DIA_0018">
        <bpmn2:targetRef>_CPL_T_TOKEN_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment id="_CPL_ASG_0019">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression" id="_CPL_FROM_0020"><![CDATA[SdcApiCall]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression" id="_CPL_TO_0021">_CPL_T_TOKEN_TaskNameInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_CPL_DOA_0022">
        <bpmn2:sourceRef>_CPL_T_TOKEN_accessTokenOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>smwAccessToken</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:task id="_CPL_T_SMW" drools:taskName="SdcApiCall" name="REST_API_CALL:
smw/createBuilding">
      <bpmn2:documentation id="_CPL_DOC_0023"><![CDATA[Creates an empty building with Access Point in SMW/PRM via glb_nig_prm_api_create_object (object_type=building, use_existing_project=true). address_id is the address master id (= globalReferenceId). (CREATE_OR_UPDATE)]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[REST_API_CALL:
smw/createBuilding]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("=================================================================");
System.out.println("=== pniDesign_createPlace - REST_API_CALL: smw/createBuilding ===");
System.out.println("=================================================================");

smwBuildingId = null;
smwBuildingName = null;
smwRequestStatus = null;
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("Data Outputs: smwBuildingId=" + smwBuildingId + ", smwBuildingName=" + smwBuildingName + ", smwRequestStatus=" + smwRequestStatus);

if (!"ok".equals(smwRequestStatus) || smwBuildingId == null || smwBuildingId.isEmpty()) {
    kcontext.setVariable("errorMessage", "SMW create building failed for address '" + globalReferenceId
        + "' in SMW project '" + smwProjectName + "': request_status=" + smwRequestStatus);
} else {
    // SMW ids are stored in CROSS as <object_type>:<id>, e.g. building:132384385 (see gc_data_PLACE_v1.xml).
    kcontext.setVariable("placeSmwId", "building:" + smwBuildingId);
    if (smwBuildingName == null || smwBuildingName.isEmpty()) {
        kcontext.setVariable("smwBuildingName", "building:" + smwBuildingId);
    }
}
]]></drools:script>
        </drools:onExit-script>
