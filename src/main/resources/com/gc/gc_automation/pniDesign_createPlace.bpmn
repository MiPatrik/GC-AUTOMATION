        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_CPL_SF_CSB_BE_TO_THROW</bpmn2:incoming>
      <bpmn2:linkEventDefinition id="_CPL_LINK_FAILED_THROW_CSB_BE" name="Failed">
        <bpmn2:target>_CPL_LINK_FAILED_CATCH</bpmn2:target>
      </bpmn2:linkEventDefinition>
    </bpmn2:intermediateThrowEvent>
    <bpmn2:scriptTask id="_CPL_SCRIPT_CSB_BE_ERROR" name="Extract SMW building error" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Extract SMW building error]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_CPL_SF_CSB_BE</bpmn2:incoming>
      <bpmn2:outgoing>_CPL_SF_CSB_BE_TO_THROW</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("=== pniDesign_createPlace - Create SMW building failed, extracting real error ===");
System.out.println("caughtException class: " + (caughtException != null ? caughtException.getClass().getName() : "null"));

String detail = null;
if (caughtException != null) {
    Throwable t = caughtException;
    int depth = 0;
    while (t != null) {
        System.out.println("Cause chain [" + depth + "]: " + t.getClass().getName() + " - " + t.getMessage());
        if (t.getCause() == null || t.getCause() == t) {
            break;
        }
        t = t.getCause();
        depth++;
    }
    detail = t.getMessage();
    if (detail == null) {
        detail = t.toString();
    }
}

System.out.println("Extracted error detail: " + detail);

kcontext.setVariable("errorMessage", "SMW create building failed: " + (detail != null ? detail : "unknown error (caughtException was null)"));
]]></bpmn2:script>
    </bpmn2:scriptTask>
