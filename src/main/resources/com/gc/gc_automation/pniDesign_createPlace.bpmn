    <bpmn2:sequenceFlow id="_CPL_SF_CSB_FAILED" name="Create SMW building failed" sourceRef="_CPL_GW_CSB" targetRef="_CPL_THROW_FAILED_CSB">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Create SMW building failed]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_CPL_COND_0002" language="http://www.java.com/java"><![CDATA[return errorMessage != null;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
