  <bpmn2:process id="GC-AUTOMATION.pniDesign_createPlace" drools:packageName="com.gc.gc_automation" drools:version="1.0" drools:adHoc="false" name="pniDesign_createPlace" isExecutable="true" processType="Public">
    <bpmn2:documentation id="_CPL_DOC_0001"><![CDATA[Sub-process of pniDesign. Creates the customer building in Smallworld/PRM (token + create_object) and then the matching PLACE node in CROSS carrying the SMW id as PNI_DE external id, so the later SMW->DTS->CROSS synchro assumes the node instead of duplicating it. Inputs: addressCrossId, globalReferenceId, crossProjectName, addressLatitude, addressLongitude. Outputs: placeCrossId, placeSmwId, errorMessage (null on success).]]></bpmn2:documentation>
    <bpmn2:extensionElements>
      <drools:global identifier="_apiCallUrl" type="String"/>
    </bpmn2:extensionElements>
    <bpmn2:property id="_apiCallUrl" itemSubjectRef="__apiCallUrlItem" name="_apiCallUrl"/>
    <bpmn2:property id="addressCrossId" itemSubjectRef="_addressCrossIdItem" name="addressCrossId"/>
    <bpmn2:property id="globalReferenceId" itemSubjectRef="_globalReferenceIdItem" name="globalReferenceId"/>
    <bpmn2:property id="crossProjectName" itemSubjectRef="_crossProjectNameItem" name="crossProjectName"/>
    <bpmn2:property id="addressLatitude" itemSubjectRef="_addressLatitudeItem" name="addressLatitude"/>
    <bpmn2:property id="addressLongitude" itemSubjectRef="_addressLongitudeItem" name="addressLongitude"/>
    <bpmn2:property id="smwSystemId" itemSubjectRef="_smwSystemIdItem" name="smwSystemId"/>
    <bpmn2:property id="smwProjectName" itemSubjectRef="_smwProjectNameItem" name="smwProjectName"/>
    <bpmn2:property id="smwAccessToken" itemSubjectRef="_smwAccessTokenItem" name="smwAccessToken"/>
    <bpmn2:property id="smwBuildingId" itemSubjectRef="_smwBuildingIdItem" name="smwBuildingId"/>
    <bpmn2:property id="smwBuildingName" itemSubjectRef="_smwBuildingNameItem" name="smwBuildingName"/>
    <bpmn2:property id="smwRequestStatus" itemSubjectRef="_smwRequestStatusItem" name="smwRequestStatus"/>
    <bpmn2:property id="placeCrossId" itemSubjectRef="_placeCrossIdItem" name="placeCrossId"/>
    <bpmn2:property id="placeSmwId" itemSubjectRef="_placeSmwIdItem" name="placeSmwId"/>
    <bpmn2:property id="httpStatusCode" itemSubjectRef="_httpStatusCodeItem" name="httpStatusCode"/>
    <bpmn2:property id="message" itemSubjectRef="_messageItem" name="message"/>
    <bpmn2:property id="errorMessage" itemSubjectRef="_errorMessageItem" name="errorMessage"/>
    <bpmn2:sequenceFlow id="_CPL_SF_01" sourceRef="_CPL_START" targetRef="_CPL_INIT"/>
