      </bpmn2:extensionElements>
      <bpmn2:incoming>_CPL_SF_05</bpmn2:incoming>
      <bpmn2:linkEventDefinition id="_CPL_LINK_FAILED_THROW_TOKEN" name="Failed">
        <bpmn2:target>_CPL_LINK_FAILED_CATCH</bpmn2:target>
