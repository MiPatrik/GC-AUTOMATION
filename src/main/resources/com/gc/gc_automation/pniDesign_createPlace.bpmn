      </bpmn2:linkEventDefinition>
    </bpmn2:intermediateThrowEvent>
    <bpmn2:intermediateThrowEvent id="_CPL_THROW_FAILED_CROSS" name="Failed">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Failed]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_CPL_SF_11</bpmn2:incoming>
      <bpmn2:linkEventDefinition id="_CPL_LINK_FAILED_THROW_CROSS" name="Failed">
        <bpmn2:target>_CPL_LINK_FAILED_CATCH</bpmn2:target>
      </bpmn2:linkEventDefinition>
    </bpmn2:intermediateThrowEvent>
    <bpmn2:intermediateCatchEvent id="_CPL_CATCH_COMPLETED" name="Completed">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Completed]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_CPL_SF_12</bpmn2:outgoing>
      <bpmn2:linkEventDefinition id="_CPL_LINK_COMPLETED_CATCH" name="Completed">
        <bpmn2:source>_CPL_LINK_COMPLETED_THROW</bpmn2:source>
      </bpmn2:linkEventDefinition>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:intermediateCatchEvent id="_CPL_CATCH_FAILED" name="Failed">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Failed]]></drools:metaValue>
