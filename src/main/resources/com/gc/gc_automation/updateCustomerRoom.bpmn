    <bpmn2:scriptTask id="_308AF56D-8B1A-4B9D-81F1-D546F32D9087" name="find cpeCrossId" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[find cpeCrossId]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
